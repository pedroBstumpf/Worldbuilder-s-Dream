# Copie para .env (que nunca é commitado) e preencha. Só para a máquina de desenvolvimento.

# pnpm db:test — banco onde os testes pgTAP rodam (ADR-0014).
# Supabase › projeto wbdream-dev › Connect › Session pooler, trocando [YOUR-PASSWORD] pela senha
# do banco (guardada no Bitwarden). Não acrescente ?sslmode=… (o script cuida do TLS).
DB_TEST_URL=

# Opcional: certificado do Supabase (Database › Settings › SSL Configuration › Download certificate)
# para o script verificar o servidor. Sem ele a conexão é criptografada, mas sem verificação.
DB_TEST_CA=
