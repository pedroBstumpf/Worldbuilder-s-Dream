{
  "extends": ["stylelint-config-standard"],
  "rules": {
    "at-rule-no-unknown": [
      true,
      {
        "ignoreAtRules": [
          "theme",
          "utility",
          "apply",
          "variant",
          "custom-variant",
          "source",
          "plugin",
          "config",
          "reference"
        ]
      }
    ],
    "import-notation": "string",
    "custom-property-pattern": [
      "^[a-z][a-z0-9]*(-{1,2}[a-z0-9]+)*(-\\*)?$",
      {
        "message": "Use kebab-case (o @theme do Tailwind também aceita --nome--sub e --nome-*)"
      }
    ]
  }
}
